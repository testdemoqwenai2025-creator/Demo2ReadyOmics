{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessera.bio/schema/dataset-card.v0.3.json",
  "title": "Tessera Bio Dataset Card v0.3",
  "description": "Additive over v0.2 — v0.2 cards validate unchanged against v0.3. The headline addition is single-cell RNA-seq support. Single-cell ML's most common silent failure is donor cells split across train and test, which inflates test metrics. v0.3 makes the held_out_donors_cells split strategy first-class, adds cell-level QC fields, and pins the 10x chemistry and cell-type taxonomy used for annotation. Together these turn single-cell ML from a leaky discipline into a reproducible one.",
  "type": "object",
  "required": [
    "dataset_id",
    "dataset_version",
    "release_date",
    "producer",
    "licence",
    "cohort_definition",
    "reference_versions",
    "pipeline",
    "inputs",
    "quality",
    "batch_effects",
    "splits",
    "normalisation",
    "known_biases",
    "suggested_uses",
    "discouraged_uses",
    "identifier_drift_report",
    "provenance",
    "modalities",
    "cross_modal_join",
    "release_hash",
    "schema_version"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "description": "Globally unique identifier, namespaced: tessera.<assay-or-multiomic>.<version>.<cohort>.<reference>",
      "pattern": "^tessera\\."
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "release_date": { "type": "string", "format": "date" },
    "producer": { "type": "string" },
    "licence": { "type": "string" },
    "cohort_definition": {
      "type": "object",
      "required": ["n_samples", "n_donors", "species", "tissue", "disease_focus", "selection_criteria"],
      "properties": {
        "n_samples": { "type": "integer", "minimum": 0 },
        "n_donors": { "type": "integer", "minimum": 0 },
        "n_cells": {
          "type": "integer",
          "minimum": 0,
          "description": "Total cells in the cohort after QC. Required when any modality has name == 'single-cell-rna-seq'. Optional otherwise."
        },
        "species": { "type": "string" },
        "tissue": { "type": "array", "items": { "type": "string" } },
        "disease_focus": { "type": "string" },
        "selection_criteria": { "type": "string" }
      }
    },
    "reference_versions": {
      "type": "object",
      "required": ["ensembl_release", "ensembl_assembly", "uniprot_release", "gene_id_type", "transcript_id_type"],
      "properties": {
        "ensembl_release": { "type": "integer" },
        "ensembl_assembly": { "type": "string" },
        "uniprot_release": { "type": "string" },
        "gene_id_type": { "type": "string" },
        "transcript_id_type": { "type": "string" }
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["pipeline_name", "pipeline_version", "pipeline_url", "container_hash", "pipeline_commit", "workflow_lang", "tools"],
      "properties": {
        "pipeline_name": { "type": "string" },
        "pipeline_version": { "type": "string" },
        "pipeline_url": { "type": "string" },
        "container_hash": { "type": "string" },
        "pipeline_commit": { "type": "string" },
        "workflow_lang": { "type": "string" },
        "tools": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "source_url", "source_licence", "n_samples_taken", "submitters_acknowledgement"],
        "properties": {
          "source_id": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "source_licence": { "type": "string" },
          "n_samples_taken": { "type": "integer", "minimum": 0 },
          "submitters_acknowledgement": { "type": "string" }
        }
      }
    },
    "quality": {
      "type": "object",
      "required": ["median_reads_per_sample", "median_mapping_rate", "median_duplication", "median_3_prime_bias", "failed_qc_samples", "qc_threshold"],
      "properties": {
        "median_reads_per_sample": { "type": "integer" },
        "median_mapping_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "median_duplication": { "type": "number", "minimum": 0, "maximum": 1 },
        "median_3_prime_bias": { "type": "number", "minimum": 0, "maximum": 1 },
        "failed_qc_samples": { "type": "array", "items": { "type": "string" } },
        "qc_threshold": { "type": "string" }
      }
    },
    "batch_effects": {
      "type": "object",
      "required": ["detected", "correction_method", "before_correction_pca_explained_by_batch", "after_correction_pca_explained_by_batch"],
      "properties": {
        "detected": { "type": "boolean" },
        "correction_method": { "type": "string" },
        "before_correction_pca_explained_by_batch": { "type": "number" },
        "after_correction_pca_explained_by_batch": { "type": "number" }
      }
    },
    "splits": {
      "type": "object",
      "required": ["split_strategy", "train", "validation", "test", "leakage_controls"],
      "properties": {
        "split_strategy": {
          "type": "string",
          "description": "v0.3 adds 'held_out_donors_cells' as the canonical single-cell strategy — equivalent in logic to held_out_donors but documents that the unit of leakage control is the donor (not the cell).",
          "enum": [
            "held_out_cohorts",
            "held_out_donors",
            "held_out_donors_cells",
            "held_out_donors_timepoints",
            "held_out_lineages"
          ]
        },
        "train": {
          "type": "object",
          "required": ["n_samples", "cohort_ids"],
          "properties": {
            "n_samples": { "type": "integer" },
            "n_cells": { "type": "integer", "description": "Total cells in this split. Required for single-cell cards." },
            "cohort_ids": { "type": "array", "items": { "type": "string" } },
            "donor_ids": { "type": "array", "items": { "type": "string" }, "description": "Donor IDs in this split — for single-cell, makes donor-level leakage audit trivial." }
          }
        },
        "validation": {
          "type": "object",
          "required": ["n_samples", "cohort_ids"],
          "properties": {
            "n_samples": { "type": "integer" },
            "n_cells": { "type": "integer" },
            "cohort_ids": { "type": "array", "items": { "type": "string" } },
            "donor_ids": { "type": "array", "items": { "type": "string" } }
          }
        },
        "test": {
          "type": "object",
          "required": ["n_samples", "cohort_ids"],
          "properties": {
            "n_samples": { "type": "integer" },
            "n_cells": { "type": "integer" },
            "cohort_ids": { "type": "array", "items": { "type": "string" } },
            "donor_ids": { "type": "array", "items": { "type": "string" } }
          }
        },
        "leakage_controls": {
          "type": "object",
          "required": ["donor_overlap_check", "family_overlap_check"],
          "properties": {
            "donor_overlap_check": { "type": "string" },
            "family_overlap_check": { "type": "string" },
            "cell_donor_overlap_check": {
              "type": "string",
              "description": "v0.3: explicit verification that no donor's cells appear in two splits. Required for single-cell cards."
            }
          }
        }
      }
    },
    "normalisation": {
      "type": "object",
      "required": ["method", "reference_distribution", "apply_to_test"],
      "properties": {
        "method": { "type": "string" },
        "reference_distribution": { "type": "string" },
        "apply_to_test": { "type": "string" }
      }
    },
    "known_biases": { "type": "array", "items": { "type": "string" } },
    "suggested_uses": { "type": "array", "items": { "type": "string" } },
    "discouraged_uses": { "type": "array", "items": { "type": "string" } },
    "identifier_drift_report": {
      "type": "object",
      "required": ["compared_to_ensembl_release", "genes_added", "genes_removed", "genes_merged", "genes_split", "impact_on_dataset"],
      "properties": {
        "compared_to_ensembl_release": { "type": "integer" },
        "genes_added": { "type": "integer" },
        "genes_removed": { "type": "integer" },
        "genes_merged": { "type": "integer" },
        "genes_split": { "type": "integer" },
        "impact_on_dataset": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["output_matrix_sha256", "dataset_card_sha256", "signed_by"],
      "properties": {
        "output_matrix_sha256": { "type": "string" },
        "dataset_card_sha256": { "type": "string" },
        "signed_by": { "type": "string" }
      }
    },
    "schema_version": {
      "type": "string",
      "description": "Schema version this card validates against. v0.1 cards may omit this; v0.2 cards set '0.2.0'; v0.3 cards set '0.3.0'.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "modalities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "assay_type", "n_features", "feature_id_type", "reference_release", "matrix_path", "normalisation"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Modality name. v0.3 adds 'single-cell-rna-seq' as a first-class value.",
            "enum": ["rna-seq", "single-cell-rna-seq", "proteomics", "metabolomics"]
          },
          "assay_type": { "type": "string" },
          "n_features": { "type": "integer", "minimum": 0 },
          "n_cells": {
            "type": "integer",
            "minimum": 0,
            "description": "v0.3: total cells in this modality after QC. Required when name == 'single-cell-rna-seq'."
          },
          "feature_id_type": { "type": "string" },
          "reference_release": { "type": "string" },
          "matrix_path": { "type": "string" },
          "normalisation": {
            "type": "object",
            "required": ["method", "reference_distribution", "apply_to_test"],
            "properties": {
              "method": { "type": "string" },
              "reference_distribution": { "type": "string" },
              "apply_to_test": { "type": "string" }
            }
          },
          "quality": { "type": "object" }
        }
      }
    },
    "cross_modal_join": {
      "type": "object",
      "required": ["join_type", "join_keys", "n_paired_samples", "per_donor_consistency_check"],
      "properties": {
        "join_type": {
          "type": "string",
          "enum": ["single_modality", "per_sample", "per_donor", "per_donor_timepoint", "per_cell"]
        },
        "join_keys": { "type": "array", "items": { "type": "string" } },
        "n_paired_samples": { "type": "integer", "minimum": 0 },
        "per_donor_consistency_check": { "type": "string" }
      }
    },
    "release_hash": {
      "type": "string",
      "pattern": "^tessera-release:[0-9a-f]{12,64}$",
      "description": "Content-addressable release hash. Computed as SHA-256 of the canonical JSON manifest of all bundled artefacts. Required since v0.2."
    },
    "single_cell_metadata": {
      "type": "object",
      "description": "v0.3: required when any modality has name == 'single-cell-rna-seq'. Optional otherwise. Encodes the cell-level QC and annotation context that bulk RNA-seq cards do not carry.",
      "required": ["n_cells", "chemistry", "cell_type_taxonomy", "per_cell_qc_threshold"],
      "properties": {
        "n_cells": { "type": "integer", "minimum": 0, "description": "Total cells after QC filtering, across all donors" },
        "chemistry": {
          "type": "string",
          "description": "10x Genomics chemistry version, pinned. Examples: '10x-v3', '10x-v3.1', '10x-Multiome'. Different chemistries have different gene coverage and noise floors — mixing them silently corrupts cross-cohort comparisons."
        },
        "cell_type_taxonomy": {
          "type": "string",
          "description": "Reference taxonomy used for cell type annotation. Examples: 'CellTypist v1.5', 'Azimuth v0.4.5', 'manual expert annotation'. Pinned — re-running with a different taxonomy changes the labels and requires a new release hash."
        },
        "cell_type_counts": {
          "type": "object",
          "description": "Per-cell-type cell counts, after QC filtering. Keys are cell type names from the pinned taxonomy.",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "per_cell_qc_threshold": {
          "type": "object",
          "description": "QC thresholds applied at the single-cell level. These are the gates a cell must pass to enter the released matrix.",
          "required": ["min_genes_per_cell", "max_genes_per_cell", "max_mito_fraction", "doublet_method"],
          "properties": {
            "min_genes_per_cell": { "type": "integer", "minimum": 0 },
            "max_genes_per_cell": { "type": "integer", "minimum": 0 },
            "max_mito_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
            "doublet_method": { "type": "string", "description": "e.g., 'Scrublet v0.2.3', 'DoubletFinder v4.4'" }
          }
        },
        "aggregation_method": {
          "type": "string",
          "description": "How per-donor pseudobulks were computed (if applicable). Examples: 'sum across cells per donor', 'mean across cells per donor', 'none (per-cell models)'."
        }
      }
    }
  },
  "additionalProperties": false,
  "$comment": "Schema version 0.3.0. Additive over v0.2 — no existing required field was removed or renamed. A v0.2 card validates against v0.3 unchanged. New fields: cohort_definition.n_cells (optional), splits.split_strategy enum gains 'held_out_donors_cells' and 'held_out_donors_timepoints', splits.{train,validation,test}.n_cells and .donor_ids (optional), splits.leakage_controls.cell_donor_overlap_check (optional), modalities[].name gains 'single-cell-rna-seq', modalities[].n_cells (optional, required for single-cell), cross_modal_join.join_type gains 'per_cell', single_cell_metadata (top-level optional, required when single-cell modality present). Migration tooling: `tessera migrate-card --from 0.2 --to 0.3 <card.yaml>` produces a v0.3 card identical to the v0.2 card. Single-cell cards require manual enrichment with single_cell_metadata."
}
